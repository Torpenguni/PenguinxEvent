DATABASE_URL=postgres://localhost:5432/penguinxevent
JWT_SECRET=เปลี่ยนค่านี้ก่อนขึ้นจริง
PORT=4000
WEB_ORIGIN=http://localhost:5173

# ตั้งเป็น portal เฉพาะโปรเจกต์ของโดเมนผู้ออกบูธ ไม่ตั้ง = โดเมนของทีมข้างใน
PXE_APP=
# โดเมนพอร์ทัล ใช้ประกอบลิงก์เชิญที่ทีมสร้างให้ผู้ออกบูธ
PORTAL_URL=https://exhibitor.penguinx.co

# --- อีเมล ---
# สวิตช์ใหญ่ ต้องเป็นคำว่า true เป๊ะ ๆ ถึงจะส่งจริง อย่างอื่นทั้งหมดคือไม่ส่ง
# แต่ยังบันทึกลง mail_log เป็น skipped ทุกฉบับ
MAIL_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=Penguin X <noreply@penguinx.co>
# ตอนทดสอบ ใส่กล่องของตัวเองไว้ เมลทุกฉบับจะถูกเปลี่ยนผู้รับมาที่นี่
# ผู้รับตัวจริงยังถูกบันทึกไว้ในคอลัมน์ to ของ mail_log ตามเดิม
MAIL_REDIRECT_TO=
# เตือนงานที่ครบกำหนดภายในกี่วัน (และงานที่เลยกำหนดแล้วทั้งหมด)
REMINDER_WINDOW_DAYS=14
# Vercel cron ใช้ค่านี้ยืนยันตัว ไม่ตั้ง = ปิดปลายทาง cron ทั้งหมด
CRON_SECRET=
# โดเมนบริษัท ใช้ตัดสินว่าอีเมลไหนเป็นคนนอก
COMPANY_DOMAIN=penguinx.co
